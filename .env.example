# PromptOps Studio environment template
# Copy relevant values into local files as described below.

# Frontend local file: apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend local file: apps/api/.dev.vars
# JWT_SECRET=replace_with_random_dev_secret
# GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
# GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
# ENCRYPTION_KEY=replace_with_32+_byte_key_material

# Production secrets should be set in platform secret managers only.
