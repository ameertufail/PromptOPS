{
  "name": "promptops-studio",
  "private": true,
  "version": "0.0.0",
  "description": "PromptOps Studio monorepo",
  "scripts": {
    "install:deps": "corepack pnpm install",
    "install:ci": "corepack pnpm install --frozen-lockfile",
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r build",
    "build:web": "corepack pnpm --filter @promptops/web build",
    "build:api": "corepack pnpm --filter @promptops/api build",
    "deploy:api": "corepack pnpm --filter @promptops/api exec wrangler deploy --env production",
    "tail:api": "corepack pnpm --filter @promptops/api exec wrangler tail --env production",
    "lint": "corepack pnpm -r lint",
    "lint:fix": "corepack pnpm -r lint:fix",
    "format": "corepack pnpm exec prettier --write .",
    "format:check": "corepack pnpm exec prettier --check .",
    "typecheck": "corepack pnpm -r typecheck",
    "fix": "corepack pnpm lint:fix && corepack pnpm format && corepack pnpm typecheck",
    "test": "corepack pnpm -r test"
  },
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "vitest": "^3.0.8"
  }
}
