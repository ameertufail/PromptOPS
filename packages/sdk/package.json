{
  "name": "@promptops/sdk",
  "version": "0.0.0",
  "description": "PromptOps Studio SDK",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run packages/sdk/src --config vitest.config.ts --root ../../",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@promptops/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
