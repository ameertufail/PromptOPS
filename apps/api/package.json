{
  "name": "@promptops/api",
  "private": true,
  "version": "0.0.0",
  "description": "PromptOps Studio backend API on Cloudflare Workers",
  "scripts": {
    "db:apply:core:local": "wrangler d1 execute promptops-db --file=src/db/migrations/001_core_tenancy.sql --local",
    "db:apply:all:local": "node ./scripts/run-migrations.mjs --local",
    "db:apply:all:remote": "node ./scripts/run-migrations.mjs --remote",
    "db:validate:core": "node ./scripts/validate-core-tenancy-migrations.mjs",
    "db:validate:all": "node ./scripts/validate-all-migrations.mjs",
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run apps/api/src --config vitest.config.ts --root ../../",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@promptops/shared": "workspace:*",
    "hono": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.2.0"
  }
}
