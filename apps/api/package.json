{
  "name": "@promptops/api",
  "private": true,
  "version": "0.0.0",
  "description": "PromptOps Studio backend API on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "test": "vitest run apps/api/src --config vitest.config.ts --root ../../",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@promptops/shared": "workspace:*",
    "hono": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.2.0"
  }
}
